# CrediiFlow Backend Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECURE SECRETS BEFORE DEPLOYING

ENVIRONMENT=development
PORT=8000

# Central Master Database Connection
MASTER_DATABASE_URL=postgresql://doit_admin:CHANGE_ME_IN_PRODUCTION@localhost:5432/crediiflow_master
DB_USER=doit_admin
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=localhost
DB_PORT=5432

# Security & Tokens (Generate secure 64-char keys for production)
JWT_SECRET_KEY=generate-a-secure-random-64-character-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.crediiflow.in

# Cloudflare R2 Storage (Optional)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
